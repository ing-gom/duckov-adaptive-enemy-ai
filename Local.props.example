<Project>
  <!-- Ducky SDK를 사용한 프로젝트 설정 -->
  <!-- 이 파일을 Local.props로 복사하여 사용하세요 -->
  <!-- Local.props는 .gitignore에 포함되어 있어 버전 관리에 포함되지 않습니다 -->
  
  <PropertyGroup>
    <!-- Steam 게임 설치 경로 -->
    <!-- Windows 기본 경로 -->
    <SteamFolder Condition="'$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Escape from Duckov</SteamFolder>
    
    <!-- Linux 기본 경로 -->
    <SteamFolder Condition="'$(OS)' != 'Windows_NT'">$(HOME)/.steam/steam/steamapps/common/Escape from Duckov</SteamFolder>
    
    <!-- DuckovFolder는 SteamFolder와 동일하게 설정 -->
    <DuckovFolder>$(SteamFolder)</DuckovFolder>
  </PropertyGroup>
</Project>

